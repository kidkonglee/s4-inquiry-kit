{
  "on_http_request": [
    {
      "expressions": [
        "!(req.url.path in ['/api/health', '/api/join', '/api/me', '/api/events'])"
      ],
      "actions": [
        {
          "type": "custom-response",
          "config": {
            "status_code": 404,
            "body": "{\"error\":\"Not found\"}",
            "headers": {
              "content-type": "application/json"
            }
          }
        }
      ]
    },
    {
      "actions": [
        {
          "type": "rate-limit",
          "config": {
            "algorithm": "sliding_window",
            "capacity": 2400,
            "rate": "60s",
            "bucket_key": [
              "req.url.host"
            ],
            "name": "s4-classroom-global"
          }
        }
      ]
    }
  ]
}
